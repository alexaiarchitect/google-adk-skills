#: Used when the config names the metric without a criterion of its own.
DEFAULT_THRESHOLD = {{THRESHOLD}}

#: The eval config entry that registers this metric. Validate it with
#: `EvalConfig.model_validate(CONFIG_SNIPPET)`.
CONFIG_SNIPPET = {{CONFIG_SNIPPET_PY}}


def _threshold(eval_metric: EvalMetric) -> float:
    """The configured threshold, read from the place ADK actually populates.

    `eval_metric.threshold` is blanked before this function is called, so it is
    never the right source. `eval_metric.criterion` carries the criterion the
    config declared, and `BaseCriterion.threshold` is the number on it.
    """
    criterion = getattr(eval_metric, "criterion", None)
    threshold = getattr(criterion, "threshold", None)
    return DEFAULT_THRESHOLD if threshold is None else float(threshold)


def _status(score: Optional[float], threshold: float) -> EvalStatus:
    """No score is NOT_EVALUATED, never a failure: conflating the two is how a
    broken suite looks green, or a healthy one red."""
    if score is None:
        return EvalStatus.NOT_EVALUATED
    return EvalStatus.PASSED if score >= threshold else EvalStatus.FAILED


