[project]
name = "{{PROJECT_NAME}}"
version = "0.1.0"
description = "{{AGENT_DESCRIPTION}}"
requires-python = ">=3.11"
dependencies = [
    "google-adk[eval]>=2.10,<3",
    "pydantic>=2",
    "python-dotenv>=1",
]

[project.optional-dependencies]
test = ["pytest>=8", "pytest-asyncio>=0.23"]

[tool.pytest.ini_options]
asyncio_mode = "auto"
