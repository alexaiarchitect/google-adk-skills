# Vertex AI: the backend this project's evals assume.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project
GOOGLE_CLOUD_LOCATION=us-central1

# Gemini API instead (no Vertex-only metrics: no safety_v1, no multi_turn_*):
# GOOGLE_GENAI_USE_VERTEXAI=FALSE
# GOOGLE_API_KEY=your-key

# Read by the agent and by generated eval configs. Never hardcode a dated id.
MODEL_NAME=gemini-flash-latest

# Optional: silence ADK's [EXPERIMENTAL] warnings (the YAML loader's through 2.13.0,
# gone on main after 2.13.0; from 2.13 also the feature registry's).
# ADK_SUPPRESS_EXPERIMENTAL_FEATURE_WARNINGS=1
