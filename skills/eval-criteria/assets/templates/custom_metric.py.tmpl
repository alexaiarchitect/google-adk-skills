"""Custom metric: {{METRIC_NAME}}.

{{METRIC_DESCRIPTION}}

Register it in the eval config by its dotted path:

    {
      "criteria": {
        "{{METRIC_NAME}}": {
          "threshold": {{THRESHOLD}},
          "custom_function_path": "{{DOTTED_PATH}}"
        }
      }
    }

The module has to be importable from wherever the evaluation runs, because ADK
resolves that path with `importlib.import_module`. Keeping it inside the agent
package is the reliable way to arrange that.

**The one gotcha.** `_CustomMetricEvaluator` copies the `EvalMetric` and sets
`eval_metric.threshold = None` before calling this function. Reading
`eval_metric.threshold` therefore always gives `None`, and a comparison against
it raises or silently passes everything. The threshold lives on
`eval_metric.criterion.threshold`.
"""

from __future__ import annotations

from typing import Optional

from google.adk.evaluation.eval_case import ConversationScenario
from google.adk.evaluation.eval_case import Invocation
from google.adk.evaluation.eval_metrics import EvalMetric
from google.adk.evaluation.evaluator import EvalStatus
from google.adk.evaluation.evaluator import EvaluationResult
from google.adk.evaluation.evaluator import PerInvocationResult

#: Used when the config names the metric without a criterion of its own.
DEFAULT_THRESHOLD = {{THRESHOLD}}


def _threshold(eval_metric: EvalMetric) -> float:
    """The configured threshold, read from the place ADK actually populates.

    `eval_metric.threshold` is blanked before this function is called, so it is
    never the right source. `eval_metric.criterion` carries the criterion the
    config declared, and `BaseCriterion.threshold` is the number on it.
    """
    criterion = getattr(eval_metric, "criterion", None)
    threshold = getattr(criterion, "threshold", None)
    return DEFAULT_THRESHOLD if threshold is None else float(threshold)


def _score_one(
    actual: Invocation,
    expected: Optional[Invocation],
) -> float:
    """Score a single invocation, between 0.0 and 1.0.

    TODO: the real rule. This is the whole reason for a custom metric - it
    should be something deterministic that the built-in catalog cannot express,
    such as a business invariant ("a submitted claim id must match the one the
    user gave") or a domain check a judge would score inconsistently.

    Keep it deterministic. A custom metric that calls a model is a judge metric
    with none of the calibration machinery, and it will drift.
    """
    del expected                       # TODO: compare against the golden trace
    tool_names = []
    intermediate = getattr(actual, "intermediate_data", None)
    for tool_use in getattr(intermediate, "tool_uses", None) or []:
        name = getattr(tool_use, "name", None)
        if name:
            tool_names.append(name)
    return 1.0 if tool_names else 0.0


